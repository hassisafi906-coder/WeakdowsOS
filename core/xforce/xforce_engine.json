{
  "xforce_module": "XForce Cloud Gaming Engine",
  "version": "1.0.0",
  "streaming_protocols": [
    "WebRTC",
    "Low-Latency RTSP",
    "Direct-X Cloud Stream"
  ],
  "performance_profile": {
    "target_fps": 60,
    "max_resolution": "1080p",
    "adaptive_bitrate": true,
    "hardware_acceleration": "enabled"
  },
  "compatibility": {
    "supported_platforms": ["Windows", "Linux", "macOS", "BSD"],
    "minimum_bandwidth_mbps": 5
  }
}
